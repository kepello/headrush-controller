#pragma once
// Development-only shortcut. NOT required for normal operation.
//
// Once Stage 2 (on-screen WiFi provisioning) is built, you should provision via
// the native UI and delete your local secrets.h — credentials will live in NVS.
//
// To use during early bench bring-up, copy this file to include/secrets.h (which is
// gitignored) and fill in your creds. If WIFI_SSID is non-empty, main.cpp uses
// these values; otherwise it reads from NVS, or fails out loudly if NVS is empty.

#define WIFI_SSID ""
#define WIFI_PSK  ""

// Optional: skip mDNS lookup if your LAN is unreliable.
#define HEADRUSH_HOST_OVERRIDE ""

// Optional: password required to push an OTA firmware update. Leave empty for
// no auth (fine on a trusted home LAN). If set, the uploader must pass a
// matching --auth=... (see the crowpanel_128_ota env in platformio.ini).
#define OTA_PASSWORD ""
